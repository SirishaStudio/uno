# Local dev: PartyKit's dev server default
NEXT_PUBLIC_PARTYKIT_HOST=localhost:1999

# Production: your deployed PartyKit host, e.g. uno-web-app.yourname.partykit.dev
# Set this in Vercel's Project Settings -> Environment Variables after running
# `npx partykit deploy`.
# NEXT_PUBLIC_PARTYKIT_HOST=uno-web-app.yourname.partykit.dev
